{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayat-of-the-day",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "triggers": {
    "crons": ["0 14 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ayat-of-the-day",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
